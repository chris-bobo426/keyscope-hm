{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true
  },
  "include": [
    "core-ts/**/*",
    "baselines/**/*",
    "eval/**/*",
    "realworld/**/*",
    "dynamic/**/*",
    "report/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "bench",
    "realworld/repos"
  ]
}
